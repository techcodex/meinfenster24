{
    "name": "meinfenster24/review-cards",
    "description": "Responsive review cards backed by SQLite (coding assessment)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": { "sort-packages": true }
}
